__pycache__/
*.pyc
.venv/
venv/
.env
*.db
*.sqlite3
.pytest_cache/
.DS_Store

# local tooling + temp
# Ignore local Claude settings, but SHARE the subagent definitions.
# Must be .claude/* not .claude/ - git will not descend into an
# excluded directory, so a negation under it can never re-include.
.claude/*
!.claude/agents/
s.out
s.err
scratch_s.out
scratch_s.err

# frontend build tooling (node deps never committed; only the built web/ ships)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
*.local
npm-debug.log*
# SQLite backup snapshots (*.db is covered above; .bak suffixes are not)
*.db.bak
*.db.bak.*

# Local agent/orchestration tooling — never part of the deployed app
hive/
roster.json
roster-backups/
