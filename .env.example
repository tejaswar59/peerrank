# Copy to .env and adjust. Never commit the real .env.

# ---- Database ----
# SQLite for local dev. Swap for a Postgres URL with no code changes,
# e.g. DATABASE_URL=postgresql+psycopg://user:pass@host:5432/peerrank
DATABASE_URL=sqlite:///./peerrank.db

APP_NAME=Peer Rank

# ---- Auth (Google OAuth 2.0) ----
# Sign-in is REQUIRED to vote, and admin rights are required to create a poll.
# Signing key for the session cookie. Generate a real one for anything shared:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me

# From Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL of this app. The OAuth client's "Authorized redirect URIs" must
# contain <APP_BASE_URL>/auth/google/callback exactly, or sign-in fails.
# Dev: http://localhost:5173 (Vite proxies both /api and /auth to :8000)
# Prod: https://peerrank.arcitech.ai
APP_BASE_URL=http://localhost:5173

# Set true when served over HTTPS (marks the session cookie Secure).
HTTPS_ONLY=false

# ---- Access control ----
# Only Google accounts on this domain may sign in at all (no leading @).
ALLOWED_EMAIL_DOMAIN=arcitech.ai

# Comma-separated addresses allowed in despite being outside the domain above.
# Use this to let external voters in without widening the whole domain.
ALLOWED_EMAIL_EXCEPTIONS=

# REQUIRED to do anything useful. Comma-separated, case-insensitive. These
# accounts are the only ones that can create polls or view results/dashboard.
# Leave this empty and NOBODY can create a poll - not even you.
ADMIN_EMAILS=

# ---- Misc ----
# Allowed browser origins (comma-separated). The SPA is same-origin with the
# API and CORS credentials are off, so "*" is fine.
CORS_ORIGINS=*

# Auto-close sweep cadence (seconds) - closes any poll whose timer ran out
# even if nobody has the page open.
SWEEP_INTERVAL_SECONDS=15

# Timer bounds offered when creating a poll (minutes).
MIN_DURATION_MINUTES=1
MAX_DURATION_MINUTES=1440

# Rate limits (per client IP, fixed window in seconds).
SUBMIT_RATE_MAX=10
SUBMIT_RATE_WINDOW=60
CREATE_RATE_MAX=20
CREATE_RATE_WINDOW=300
