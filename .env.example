# Copy to .env and adjust. Never commit the real .env.
# No accounts, no login — there is nothing to authenticate in this app, so
# there's no secret key / token TTL / SMTP / OAuth config to set up anymore.

# SQLite for local dev. Swap for a Postgres URL later with no code changes,
# e.g. DATABASE_URL=postgresql+psycopg://user:pass@host:5432/peerrank
#
# For managed Postgres, use the provider's CONNECTION-POOLER host. Several
# providers publish the direct host as IPv6-only, and a container without IPv6
# then fails to start with "Cannot assign requested address" (see DEPLOY.md).
DATABASE_URL=sqlite:///./peerrank.db

# Allowed browser origins (comma-separated). "*" is fine for local dev;
# set to your real frontend origin in production, e.g.
# CORS_ORIGINS=https://peerrank.arcitech.ai
CORS_ORIGINS=*

APP_NAME=Peer Rank

# Auto-close sweep cadence (seconds) — closes any poll whose timer ran out
# even if nobody has the page open. Keep this <= MIN_DURATION_SECONDS.
SWEEP_INTERVAL_SECONDS=5

# Voting-window bounds, in SECONDS (not minutes).
MIN_DURATION_SECONDS=5
MAX_DURATION_SECONDS=86400

# Rate limits (per client IP, fixed window in seconds).
#
# SUBMIT_RATE_MAX is deliberately high: a whole team usually votes at once from
# one shared public IP (office NAT / mobile carrier), so a low value rejects
# real voters. Duplicate votes are prevented by a database constraint, not by
# this limit. Also note the app must run with --proxy-headers behind a load
# balancer, or every visitor looks like the balancer's IP and shares one bucket.
SUBMIT_RATE_MAX=150
SUBMIT_RATE_WINDOW=60
CREATE_RATE_MAX=20
CREATE_RATE_WINDOW=300
